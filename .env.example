# =============================================================================
# SAIL Tour Management System — environment configuration template
# Copy to .env and fill in real values. NEVER commit the real .env file.
# =============================================================================

# --- API server ---------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Oracle Database ------------------------------------------------------
# Direct DB connection used by the Node.js API layer (repository layer).
ORACLE_DB_USER=sail_tour_app
ORACLE_DB_PASSWORD=__CHANGE_ME__
ORACLE_DB_CONNECT_STRING=__HOST__:__PORT__/__SERVICE_NAME__
ORACLE_DB_POOL_MIN=2
ORACLE_DB_POOL_MAX=10

# --- ORDS (Oracle REST Data Services) --------------------------------------
# TBD: exact ORDS endpoints/payloads are not yet confirmed (see SSoT §25).
# Populate only when the real ORDS integration endpoint is confirmed.
ORDS_BASE_URL=__TBD__
ORDS_CLIENT_ID=__TBD__
ORDS_CLIENT_SECRET=__TBD__

# --- Oracle Fusion HCM ------------------------------------------------------
# TBD: exact Fusion HCM REST endpoints/credentials are not yet confirmed.
FUSION_HCM_BASE_URL=__TBD__
FUSION_HCM_CLIENT_ID=__TBD__
FUSION_HCM_CLIENT_SECRET=__TBD__
# When true, the mock HCM adapter is used instead of calling Fusion HCM.
# Must be false in any real deployment once Fusion credentials are supplied.
HCM_USE_MOCK_ADAPTER=true

# --- Authentication / SSO ---------------------------------------------------
# TBD: exact SSO/OIDC provider is not yet confirmed (see SSoT §25).
AUTH_PROVIDER=__TBD__
AUTH_ISSUER_URL=__TBD__
AUTH_CLIENT_ID=__TBD__
AUTH_CLIENT_SECRET=__TBD__
SESSION_COOKIE_SECRET=__CHANGE_ME__
# When true, a mock auth provider issues local dev sessions instead of real SSO.
# Must be false in any real deployment once the SSO provider is confirmed.
AUTH_USE_MOCK_PROVIDER=true

# --- Attachments -------------------------------------------------------------
# TBD: max attachment size is not confirmed in the SSoT. A conservative
# development default is set here; revisit before production.
ATTACHMENT_MAX_FILE_SIZE_MB=5
ATTACHMENT_STORAGE_MODE=DB_BLOB

# --- Audit / logging -----------------------------------------------------
LOG_LEVEL=info
